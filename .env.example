# ============================================================
# Soggy Ink Games — Investor Portal Environment Variables
# Copy this file to .env.local for local development.
# Set these in Netlify → Site settings → Environment variables for production.
# ============================================================

# Supabase — get from https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # NEVER expose to browser

# Resend — get from https://resend.com/api-keys
# IMPORTANT: Set up a custom domain in Resend for reliable delivery
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=investors@soggyinkgames.com

# Portal base URL (no trailing slash)
# Local: http://localhost:4321
# Production: https://soggyinkgames.com (after proxy rewrite is live)
PORTAL_BASE_URL=https://soggyinkgames.com

# Admin / founder email — this address gets access to /investors/admin
ADMIN_EMAIL=soggyinkgames@gmail.com

# Notification email for new access requests (can be same as ADMIN_EMAIL)
FOUNDER_NOTIFICATION_EMAIL=soggyinkgames@gmail.com

# Invite secret — used to authenticate the /investors/api/invite endpoint
# Generate a strong random string: openssl rand -hex 32
INVITE_SECRET=change-this-to-a-strong-random-secret
