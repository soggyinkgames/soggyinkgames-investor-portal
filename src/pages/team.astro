---
/**
 * /team — Prospective+ gated
 * 
 * Team profiles pulled from Supabase team_members table.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const investor = Astro.locals.investor!;
const supabase = Astro.locals.supabase;

// Fetch team members
const { data: teamMembers } = await supabase
  .from('team_members')
  .select('*')
  .order('order_index', { ascending: true });

// Fetch team documents (bios, CVs)
const { data: teamDocs } = await supabase
  .from('documents')
  .select('*')
  .eq('category', 'team')
  .eq('access_level', 'prospective');
---

<BaseLayout
  title="Team — Soggy Ink Games Investor Portal"
  user={investor}
  showNav={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-10">
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-xs text-ink-muted hover:text-ink-secondary mb-6 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to dashboard
      </a>
      <div class="badge-prospective mb-4">Prospective investor</div>
      <h1 class="font-display text-3xl text-ink-primary mb-3">The Team</h1>
      <p class="text-ink-secondary leading-relaxed max-w-2xl">
        The people building Soggy Ink Games — their backgrounds, expertise, and what drives them.
      </p>
    </div>

    <div class="portal-divider mb-10"></div>

    {teamMembers && teamMembers.length > 0 ? (
      <div class="space-y-6 mb-12">
        {teamMembers.map((member, idx) => (
          <div class="portal-card flex items-start gap-6 animate-slide-up" style={`animation-delay: ${idx * 80}ms`}>
            <div class="flex-shrink-0">
              {member.photo_url ? (
                <img
                  src={member.photo_url}
                  alt={member.name}
                  class="w-16 h-16 rounded-xl object-cover border border-portal-border"
                />
              ) : (
                <div class="w-16 h-16 rounded-xl bg-portal-bg border border-portal-border flex items-center justify-center">
                  <span class="font-display text-xl text-brand-teal">
                    {member.name.charAt(0).toUpperCase()}
                  </span>
                </div>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-4 mb-2">
                <div>
                  <h3 class="font-display text-base text-ink-primary">{member.name}</h3>
                  <p class="text-xs text-brand-teal font-medium mt-0.5">{member.role}</p>
                </div>
                {member.linkedin_url && (
                  <a
                    href={member.linkedin_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ink-muted hover:text-brand-teal transition-colors flex-shrink-0"
                    title="LinkedIn profile"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
              </div>
              <p class="text-sm text-ink-secondary leading-relaxed">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="space-y-6 mb-12">
        <div class="portal-card flex items-start gap-6">
          <div class="w-16 h-16 rounded-xl bg-portal-bg border border-portal-border flex items-center justify-center flex-shrink-0">
            <span class="font-display text-xl text-brand-teal">I</span>
          </div>
          <div class="min-w-0">
            <h3 class="font-display text-base text-ink-primary">Ian Araya</h3>
            <p class="text-xs text-brand-teal font-medium mt-0.5 mb-2">Founder & Game Developer</p>
            <p class="text-sm text-ink-secondary leading-relaxed">
              [Replace with Ian's bio — background, experience, what drives him, relevant credentials.
              Add this via the Supabase team_members table.]
            </p>
          </div>
        </div>
        <div class="portal-card text-center py-8">
          <p class="text-xs text-ink-muted">
            Team profiles are loaded from the database. Add entries via Supabase Studio → team_members table.
          </p>
        </div>
      </div>
    )}
    {teamDocs && teamDocs.length > 0 && (
      <section class="mb-12">
        <h2 class="font-display text-lg text-ink-primary mb-5">Team documents</h2>
        <div class="space-y-3">
          {teamDocs.map(doc => (
            <div class="portal-card flex items-center justify-between gap-4 py-3">
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="text-sm text-ink-primary">{doc.title}</span>
              </div>
              <a href={`/api/document/${doc.id}`} target="_blank" rel="noopener noreferrer" class="btn-secondary text-xs">
                View
              </a>
            </div>
          ))}
        </div>
      </section>
    )}
    <div class="flex items-center justify-between pt-6 portal-divider">
      <a href="/milestones" class="btn-ghost text-sm">← Milestones</a>
      {investor.role === 'invested' ? (
        <a href="/hypothesis-results" class="btn-primary text-sm">Hypothesis Results →</a>
      ) : (
        <a href="/dashboard" class="btn-primary text-sm">Dashboard →</a>
      )}
    </div>
  </div>
</BaseLayout>
