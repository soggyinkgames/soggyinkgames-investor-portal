---
/**
 * /pitch-deck — Prospective+ gated
 * 
 * Embeds both "email" and "pretty" versions of the pitch deck.
 * Documents are served via the /api/document/[id] endpoint with watermarking.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const investor = Astro.locals.investor!;
const supabase = Astro.locals.supabase;

// Fetch pitch deck documents
const { data: deckDocs } = await supabase
  .from('documents')
  .select('*')
  .eq('category', 'deck')
  .eq('access_level', 'prospective')
  .order('created_at', { ascending: false });
---

<BaseLayout
  title="Pitch Deck — Soggy Ink Games Investor Portal"
  user={investor}
  showNav={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-10">
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-xs text-ink-muted hover:text-ink-secondary mb-6 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to dashboard
      </a>
      <div class="badge-prospective mb-4">Prospective investor</div>
      <h1 class="font-display text-3xl text-ink-primary mb-3">Pitch Deck</h1>
      <p class="text-ink-secondary leading-relaxed max-w-2xl">
        Our full pitch in two formats — a readable email version and a visual presentation deck.
        Both are watermarked with your details for confidentiality.
      </p>
    </div>

    <div class="portal-divider mb-10"></div>
    <div class="mb-8 p-4 rounded-xl border border-brand-yellow/20 bg-brand-yellow/5 flex items-start gap-3">
      <svg class="w-5 h-5 text-brand-yellow flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <p class="text-sm font-medium text-brand-yellow">Confidential — for your eyes only</p>
        <p class="text-xs text-brand-yellow/70 mt-0.5 leading-relaxed">
          These documents are watermarked with your email address ({investor.email}) and the current date.
          Please do not share, forward, or distribute them.
        </p>
      </div>
    </div>

    {deckDocs && deckDocs.length > 0 ? (
      <div class="space-y-6">
        {deckDocs.map(doc => (
          <div class="portal-card">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-lg bg-portal-bg border border-portal-border flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-display text-sm text-ink-primary mb-1">{doc.title}</h3>
                  {doc.description && (
                    <p class="text-xs text-ink-secondary leading-relaxed mb-2">{doc.description}</p>
                  )}
                  <div class="flex items-center gap-2">
                    <span class="badge-prospective text-[10px]">Prospective</span>
                    <span class="text-xs text-ink-muted">PDF · Watermarked</span>
                  </div>
                </div>
              </div>
              <a
                href={`/api/document/${doc.id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary text-xs flex-shrink-0"
              >
                View PDF
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="portal-card text-center py-16">
        <div class="w-14 h-14 rounded-full bg-portal-bg border border-portal-border flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h3 class="font-display text-sm text-ink-primary mb-2">Documents coming soon</h3>
        <p class="text-xs text-ink-muted max-w-xs mx-auto leading-relaxed">
          The pitch deck is being prepared. Check back soon or contact us if you need it urgently.
        </p>
      </div>
    )}
    <div class="flex items-center justify-between pt-8 portal-divider mt-10">
      <a href="/value-proposition" class="btn-ghost text-sm">← Value Proposition</a>
      <a href="/scientific-pitch" class="btn-primary text-sm">Scientific Pitch →</a>
    </div>
  </div>
</BaseLayout>
