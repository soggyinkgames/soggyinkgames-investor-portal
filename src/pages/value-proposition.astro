---
/**
 * /investors/value-proposition — Prospective+ gated
 * 
 * Brand voice, design overview, and core value proposition.
 * Content is placeholder — replace with actual copy before launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const investor = Astro.locals.investor!;
---

<BaseLayout
  title="Value Proposition — Soggy Ink Games Investor Portal"
  user={investor}
  showNav={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-10">
      <a href="/investors/dashboard" class="inline-flex items-center gap-1.5 text-xs text-ink-muted hover:text-ink-secondary mb-6 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to dashboard
      </a>
      <div class="badge-prospective mb-4">Prospective investor</div>
      <h1 class="font-display text-3xl text-ink-primary mb-3">Value Proposition</h1>
      <p class="text-ink-secondary leading-relaxed max-w-2xl">
        Why Soggy Ink Games, why now, and what makes this worth backing.
      </p>
    </div>

    <div class="portal-divider mb-10"></div>
    <section class="mb-12">
      <h2 class="font-display text-lg text-ink-primary mb-5">WHY THIS WINS</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            heading: 'The market',
            body: 'Higher education and professional training still rely heavily on passive learning tools that struggle to sustain engagement or support durable recall. Students in knowledge-intensive fields need more effective ways to practise, retain and retrieve complex information. Soggy Ink Games is initially focused on medical, nursing and university learners, with broader potential across schools, professional certification and workforce training.',
          },
          {
            heading: 'The opportunity',
            body: 'There is a clear gap between conventional study tools and immersive learning systems that combine active recall, physical interaction, spatial memory and measurable engagement. Advances in XR, AI and digital education make this possible now. Soggy Ink Games is positioned to capture the opportunity through its combination of software engineering, immersive product development, learning-system design and direct focus on high-value educational use cases.',
          },
          {
            heading: 'The differentiation',
            body: 'A first-of-its-kind immersive learning experience engineered to make knowledge stick. EQUANIMOUS combines active, physical recall with AI-agentic orchestration that automatically transforms content into memorable learning experiences—backed by expert advisors across learning, technology and commercial strategy.',
          },
        ].map(item => (
          <div class="portal-card">
            <h3 class="font-display text-sm text-brand-teal mb-3 uppercase tracking-wider">{item.heading}</h3>
            <p class="text-sm text-ink-secondary leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </section>
    <section class="mb-12">
      <h2 class="font-display text-lg text-ink-primary mb-5">Brand voice & design philosophy</h2>
      <div class="portal-card">
        <p class="text-sm text-ink-secondary leading-relaxed mb-4">
          Soggy Ink Games communicates with clarity, confidence and imagination. Our voice reflects curiosity, intelligence, ambition and a strong belief that learning should feel empowering, beautiful and deeply human.
        </p>
        <p class="text-sm text-ink-secondary leading-relaxed">
          Our design philosophy is simple: every interaction must earn its place. We design for curiosity, agency, retention and emotional impact—combining rigorous systems with memorable experiences. We refuse to compromise on accessibility, player dignity, technical quality or the integrity of the learning experience.
        </p>
      </div>
    </section>
    <section class="mb-12">
      <h2 class="font-display text-lg text-ink-primary mb-5">Business model</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="portal-card">
          <h3 class="font-display text-sm text-ink-primary mb-3">Revenue streams</h3>
          <ul class="space-y-2 text-sm text-ink-secondary">
            <li class="flex items-start gap-2">
              <span class="text-brand-teal mt-0.5">→</span>
              B2C subscriptions
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-teal mt-0.5">→</span>
              premium learning upgrades
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-teal mt-0.5">→</span>
              future expansion into adjacent high-value industries
            </li>
          </ul>
          <p class="text-sm text-ink-secondary leading-relaxed">We are solving the hard problem first so we can then easily scale exponentially to other industries and proffesions </p>
        </div>
        <div class="portal-card">
          <h3 class="font-display text-sm text-ink-primary mb-3">Unit economics</h3>
          <p class="text-sm text-ink-secondary leading-relaxed">
            As users build personalised content, progress data and learning history, the platform becomes more valuable over time—supporting stronger engagement, lower churn and higher lifetime value. AI-agentic content transformation lowers the marginal cost of creating new learning experiences, allowing recurring revenue to scale more efficiently.
          </p>
        </div>
      </div>
    </section>
    <section class="mb-12">
      <h2 class="font-display text-lg text-ink-primary mb-5">Competitive landscape</h2>
      <div class="portal-card">
        <p class="text-sm text-ink-secondary leading-relaxed mb-4">
          [Replace with your competitive analysis — who else is in this space, how you're positioned relative to them, what moats you're building.]
        </p>
        <div class="mt-4 p-3 rounded-lg bg-portal-bg border border-portal-border">
          <p class="text-xs text-ink-muted">
            Detailed competitive analysis and financial projections are available in the pitch deck.
          </p>
        </div>
      </div>
    </section>
    <div class="flex items-center justify-between pt-6 portal-divider">
      <a href="/investors/dashboard" class="btn-ghost text-sm">← Dashboard</a>
      <a href="/investors/pitch-deck" class="btn-primary text-sm">View pitch deck →</a>
    </div>
  </div>
</BaseLayout>
